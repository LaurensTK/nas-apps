{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy app naar NAS",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\deploy.ps1",
        "${input:app}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "app",
      "type": "promptString",
      "description": "Naam van de app-map om uit te rollen",
      "default": "testweb"
    }
  ]
}
